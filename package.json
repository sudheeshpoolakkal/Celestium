{
  "name": "celestium",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check-flow": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/check-flow.ts",
    "check": "tsc --noEmit",
    "check:browser": "playwright test",
    "format": "prettier --write app components lib tests playwright.config.ts next.config.ts",
    "brief": "node scripts/generate-program-brief.mjs",
    "check-site": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/check-site.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "next": "^15.5.27",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.29"
  }
